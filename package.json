{
  "name": "nexusforge",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "An evidence-first industrial decision twin, built for AMD and Evolus.",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "verify:live": "node --env-file-if-exists=.env scripts/verify-live.mjs",
    "package:transfer": "node scripts/package-transfer.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  }
}
